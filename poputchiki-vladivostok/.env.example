# Скопируйте этот файл в .env и заполните своими значениями.
# .env в репозиторий не попадает (см. .gitignore).

# Порт, на котором поднимается сервер.
# На Railway это переменную задаёт сама платформа — свою PORT там можно не ставить.
PORT=3000

# Путь к файлу базы данных SQLite (по умолчанию data/db.sqlite рядом с проектом).
# На Railway диск контейнера НЕ сохраняется между деплоями без Volume — см.
# README, раздел "Деплой на Railway": там DB_FILE должен указывать на путь
# внутри примонтированного Volume (например /data/db.sqlite), иначе база
# будет обнуляться при каждом redeploy.
DB_FILE=./data/db.sqlite

# --- Логика мэтчинга (можно менять без правки кода) ---

# Минимальное суммарное число человек в группе, чтобы считать её "найденной"
MIN_GROUP_SIZE=2

# Максимальное суммарное число человек в группе (например, вместимость машины)
MAX_GROUP_SIZE=4

# Допуск по датам при поиске совпадений, в днях (±N дней от даты заявки)
DATE_TOLERANCE_DAYS=1

# --- Админ-панель ---
# Логин и пароль для доступа к /admin (HTTP Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

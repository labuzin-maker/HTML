# Скопируйте этот файл в .env и заполните своими значениями.
# .env в репозиторий не попадает (см. .gitignore).

# Порт, на котором поднимается сервер.
# На Render эту переменную задаёт сама платформа — свою PORT там можно не ставить.
PORT=3000

# --- База данных: Turso (облачный SQLite-совместимый сервис, см. db.js) ---
# Без этих двух переменных сервер работает с обычным локальным файлом
# (data/db.sqlite) — для разработки и тестов Turso-аккаунт не нужен.
# На Render ОБЯЗАТЕЛЬНО укажите оба значения: бесплатный Render не даёт
# постоянный диск, локальный файл обнулялся бы при каждом "засыпании"/рестарте.
# См. README, раздел "Деплой на Render + Turso" — там же инструкция, как
# создать базу и получить эти значения через `turso db create` / `turso db tokens create`.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# --- Логика мэтчинга (можно менять без правки кода) ---

# Минимальное суммарное число человек в группе, чтобы считать её "найденной"
MIN_GROUP_SIZE=2

# Максимальное суммарное число человек в группе (например, вместимость машины)
MAX_GROUP_SIZE=4

# Допуск по датам при поиске совпадений, в днях (±N дней от даты заявки)
DATE_TOLERANCE_DAYS=1

# --- Админ-панель ---
# Логин и пароль для доступа к /admin (HTTP Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Push-уведомления о новых заявках (ntfy, см. README "Push-уведомления") ---
# Сервер ntfy: можно оставить публичный ntfy.sh, либо указать свой self-hosted.
NTFY_SERVER=https://ntfy.sh

# "Топик" — по сути секретное имя канала на ntfy.sh. Сгенерируйте свою длинную
# случайную строку (например: python3 -c "import secrets; print(secrets.token_hex(8))"),
# НЕ используйте простое слово — топик на публичном ntfy.sh не защищён паролем,
# кто узнает его имя, может присылать туда сообщения или их читать.
# Если оставить пустым — уведомления просто печатаются в консоль сервера.
NTFY_TOPIC=
